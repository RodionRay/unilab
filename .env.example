ENCRYPTION_KEY=
ADMIN_EMAIL=admin@uniseller.local
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
DATA_DIR=.data
TELEGRAM_WORKER_URL=http://127.0.0.1:8790
# Общий секрет кабинет↔воркер (≥32 символов, openssl rand -hex 32). Воркер без него не стартует.
# npm run dev сгенерирует значение на запуск, если пусто.
TG_WORKER_TOKEN=
# Секрет для /api/cron/auto-rescan (воркер шлёт Bearer CRON_SECRET). Отдельный от TG_WORKER_TOKEN.
# Обязателен для автообхода (≥32 символов, одинаковый у кабинета и воркера); без него воркер
# один раз предупреждает при старте и автообход не работает.
CRON_SECRET=
# Опционально: доп. Host-заголовки воркера через запятую (напр. tg-worker:8790 в docker-сети)
# TG_WORKER_ALLOWED_HOSTS=
# TG_WORKER_MAX_CONCURRENCY=4
# Сколько запросов ждут в очереди сверх MAX_CONCURRENCY, дальше 429.
# TG_WORKER_MAX_QUEUE=64
TG_WORKER_PORT=8790
# URL кабинета: воркер дергает по нему cron, cron-роуты кабинета — /api/workspace
# (без него — 127.0.0.1:<порт запроса>; npm run dev поднимает оба)
APP_URL=http://127.0.0.1:5173
# Заголовок с реальным IP клиента для лимитов по IP (по умолчанию cf-connecting-ip).
# Прокси перед приложением ОБЯЗАН перезаписывать этот заголовок, иначе клиент его подделает.
# Без такого прокси (локально, Docker/VPS через wrangler dev --local): none — лимиты по IP отключены,
# лимиты по email/пользователю остаются.
# TRUSTED_IP_HEADER=cf-connecting-ip
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
CONTACT_BOT_TOKEN=
CONTACT_CHAT_ID=
# опционально: как часто worker дергает автообход (мс), по умолчанию 5 мин
# AUTO_RESCAN_EVERY_MS=300000

AI_PROVIDER=deepseek
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=
# Дневной лимит вопросов ассистенту на одного пользователя (по умолчанию 200)
# ASSISTANT_USER_DAILY_LIMIT=200
